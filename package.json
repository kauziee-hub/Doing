{
  "name": "doing",
  "private": true,
  "version": "0.2.0",
  "description": "Doing \u2014 a free private assistant for PC files, browser tasks and meetings.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm native:build:debug && pnpm --filter @doing/desktop dev",
    "start": "pnpm --filter @doing/desktop start",
    "lint": "eslint . --max-warnings=0 && pnpm native:lint",
    "lint:ts": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run && pnpm native:test",
    "test:ts": "vitest run",
    "test:e2e": "pnpm build && playwright test -c tests/e2e/playwright.config.ts",
    "build": "pnpm native:build && pnpm --filter @doing/desktop build",
    "package:win": "pnpm build && node tools/fetch-sava-onnx.mjs && pnpm --filter @doing/desktop package:win",
    "perf": "node tools/perf/run-local-bench.mjs",
    "native:build": "cargo build --release --manifest-path native/windows-audio/Cargo.toml",
    "native:build:debug": "cargo build --manifest-path native/windows-audio/Cargo.toml",
    "native:test": "cargo test --manifest-path native/windows-audio/Cargo.toml",
    "native:lint": "cargo clippy --manifest-path native/windows-audio/Cargo.toml --all-targets -- -D warnings && cargo fmt --manifest-path native/windows-audio/Cargo.toml --check",
    "audit": "pnpm audit --prod",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
