{
  "manifest_version": 3,
  "name": "Doing — Browser assistant",
  "version": "0.5.1",
  "description": "Chat with your private Doing assistant beside the tabs you allow.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "debugger",
    "sidePanel",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Doing chat"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "stop": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Stop Doing and revoke tab access"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
